#!/usr/bin/env python3
"""Daily retro launcher. The model runs only when a project is due.

Started with --under <folder> by the SessionStart hook (hooks/retro_session.py) of the day's first session in a folder,
so it runs with that session's folder access (macOS needs no Full Disk Access) and checks only the projects that folder
covers. Without --under it checks every project, for a run by hand.

Finds the newest installed plugin copy (the cache path changes with every update), runs retro-scan --due, writes the due
project path to <state>/retros/<today>/<slug>/due.json (retro-check publish reads it), runs retro-scan itself into
that folder, and starts one headless Retro run per project, so one failing project does not stop the others. Each
project has its own folder, so a run reads and publishes for its own project only (#200). At most MAX_PROJECTS_PER_DAY
run a day; the rest stay due for the next day. The agent may write only <folder>/work/ and <state>/upstream/; the
launcher's files are out of its reach (#192). A failure leaves <state>/retro-failed, which
holds only fixed status words, an exit code and a project slug, never child output (the full output is in
<state>/retro.log). Stdlib only, Python 3.9+.
"""

import datetime
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys

SCAN_TIMEOUT = 1800
AGENT_TIMEOUT = 3600
WORK_DIR = "work"  # the agent's only run subfolder; keep in step with retro-check
DISALLOWED = ("WebFetch", "WebSearch", "Agent", "mcp__*")
SECRET_FOLDERS = (".ssh", ".aws", ".config/gcloud")  # never readable, even if a scoped rule would cover them
SECRET_PROJECT_GLOBS = ("**/.env*", "**/*.pem", "**/*.key", "**/*.tfstate*", "**/credentials*.json", "**/.npmrc",
                        "**/.netrc", "**/.pypirc", "**/id_*", "**/*.p12", "**/*.jks", ".git/config")
MARKETPLACE = "software-factory-marketplace"  # the plugin is taken from this marketplace's cache only, never a lookalike
MAX_PROJECTS_PER_DAY = 5
LOG_LIMIT = 1_000_000  # bytes; a bigger retro.log moves to retro.log.1
NO_ACCESS = "Operation not permitted"  # the EPERM text macOS privacy gives a process without access to a folder
CLAIMS = "retro-started"  # in <state>: <day>-project-<hash> is made by the day's first run of a project (the
# SessionStart hook keeps its per-folder stamps here too and removes older days)


def load_overlay():
    """The guarded overlay module, from hooks/ next to this file, else from the plugin root found in the cache (this
    launcher is copied to <state>/bin at install, where hooks/ is not next to it)."""
    here = Path(__file__).resolve().parents[1]
    root = here if (here / "hooks" / "overlay.py").is_file() else newest_plugin()
    if root is None:
        return None
    sys.path.insert(0, str(root / "hooks"))
    import overlay
    return overlay


def state_dir():
    overlay = load_overlay()
    if overlay:
        return overlay.state_dir()
    return Path(os.environ.get("SOFTWARE_FACTORY_HOME") or Path.home() / ".software-factory")


def version_key(path):
    return tuple(int(x) for x in path.name.split(".")) if re.match(r"^\d+(\.\d+)*$", path.name) else ()


def newest_plugin(cache=None):
    cache = cache or Path.home() / ".claude" / "plugins" / "cache"
    found = [p.parents[1] for p in cache.glob(f"{MARKETPLACE}/software-factory/*/agents/retro.md")]
    return max(found, key=version_key) if found else None


def plugin_root():
    here = Path(__file__).resolve().parents[1]
    return here if (here / "agents" / "retro.md").is_file() else newest_plugin()


def read_rule(folder):
    return f"Read(/{folder}/**)"  # absolute paths in permission rules take a leading '//'; others are cwd-relative


def allowed_tools(root, state, run_dir, project, slug):
    """One rule per allowed command. No network, git, MCP or scan tool. Edit rules (the only ones that grant writes)
    cover <run>/work and upstream/ and nothing else, so the launcher's files stay out of reach (#154, #172, #192).
    Reads cover only this run, overlay/ and upstream/, the plugin and the due project (#197). Claude Code checks Grep and
    Glob against Read rules, so they get no rule of their own."""
    check = f"Bash(python3 {root}/scripts/retro-check"
    rules = [read_rule(folder) for folder in (run_dir, state / "overlay", state / "upstream", root, project)]
    rules += [f"{check} apply *)",
              f"{check} verdicts --project {project} --metrics {run_dir}/{slug}.json)",  # exact argv: no other project
              f"{check} lessons)",
              f"{check} scrub *)",
              f"{check} publish *)"]
    rules += [f"Edit(/{folder}/**)" for folder in (run_dir / WORK_DIR, state / "upstream")]
    return rules


def disallowed_tools(home, project):
    """Rule list. Secret globs are anchored to the project: a bare glob would be relative to the run folder."""
    secrets = [read_rule(home / folder) for folder in SECRET_FOLDERS]
    in_project = [f"Read(/{Path(project) / glob})" for glob in SECRET_PROJECT_GLOBS]
    return [*DISALLOWED, *secrets, *in_project]


def slug_map(projects):
    """{project: slug}, unique in a run: projects whose slugs collide all get a short hash of their path."""
    base = {p: re.sub(r"[^a-z0-9]", "-", Path(p).name.lower())[:16] for p in projects}
    names = list(base.values())
    return {p: s if names.count(s) == 1 else hashed_slug(p, s) for p, s in base.items()}


def hashed_slug(project, slug):
    return f"{slug[:10]}-{path_hash(project)[:5]}"


def free_slug(day_dir, project, slug):
    """The slug, or its hashed form when an earlier run today used that folder for another project."""
    try:
        listed = json.loads((day_dir / slug / "due.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return slug
    return slug if listed == [project] else hashed_slug(project, slug)


def project_folder(day_dir, project, slug):
    """<day>/<slug>/ with a due.json that lists this project only, so one run cannot read or publish for another (#200)."""
    folder = day_dir / slug
    folder.mkdir(parents=True, exist_ok=True)
    (folder / "due.json").write_text(json.dumps([project["project"]]) + "\n", encoding="utf-8")
    return folder


def path_hash(project):
    return hashlib.sha256(project.encode()).hexdigest()


def claim(state, day, project):
    """True for the first run of the day for this project. Two sessions starting at once must not run it twice."""
    claims = state / CLAIMS
    claims.mkdir(parents=True, exist_ok=True)
    try:
        os.close(os.open(claims / f"{day}-project-{path_hash(project)[:16]}", os.O_CREAT | os.O_EXCL | os.O_WRONLY,
                         0o600))
    except FileExistsError:
        return False
    return True


def fail(state, words):
    """Record the failure as fixed status words only, one line each."""
    state.mkdir(parents=True, exist_ok=True)
    (state / "retro-failed").write_text("".join(w + "\n" for w in words))
    print("retro: failed, see retro-failed", file=sys.stderr)
    return 1


def scan_due(root, log=None, under=None):
    """(due list, failure word or None). With a log, the scan's skip lines (why a project was left out) go there."""
    try:
        scan = subprocess.run([sys.executable, str(root / "scripts" / "retro-scan"), "--due",
                               *(["--under", under] if under else [])],
                              capture_output=True, text=True, timeout=SCAN_TIMEOUT)
    except subprocess.TimeoutExpired:
        return [], "scan-timeout"
    if log and scan.stderr:
        with open(log, "a", encoding="utf-8") as out:
            out.write(scan.stderr if scan.stderr.endswith("\n") else scan.stderr + "\n")
    if scan.returncode:
        return [], f"scan-failed {scan.returncode}"
    try:
        due = json.loads(scan.stdout or "[]")
    except ValueError:
        return [], "scan-failed bad-output"
    if not isinstance(due, list) or not all(isinstance(d, dict) and isinstance(d.get("project"), str) for d in due):
        return [], "scan-failed bad-output"
    if not due and NO_ACCESS in (scan.stderr or ""):  # macOS privacy hid a folder from this process
        return [], "macos-privacy-blocked"
    return due, None


def scan_project(root, run_dir, project, slug):
    """Failure word, or None when the launcher wrote <run>/<slug>.json. The agent cannot write that file (#192)."""
    since = ["--since", project["since"]] if project.get("since") else []
    cmd = [sys.executable, str(root / "scripts" / "retro-scan"), "--project", project["project"], *since,
           "--out", str(run_dir / f"{slug}.json")]
    try:
        run = subprocess.run(cmd, capture_output=True, text=True, timeout=SCAN_TIMEOUT)
    except subprocess.TimeoutExpired:
        return "scan-timeout"
    return f"scan-failed {run.returncode}" if run.returncode else None


def agent_command(root, state, run_dir, project, slug, prompt):
    """Headless call, locked down (#193): no user or local settings, no MCP, no network, no sub-agents, no prompts.
    Each rule is its own argv item; the prompt comes first so the variadic tool flags cannot swallow it."""
    return ["claude", "-p", prompt, "--plugin-dir", str(root), "--agent", "software-factory:retro",
            "--permission-mode", "dontAsk", "--setting-sources", "project", "--strict-mcp-config",
            "--disallowedTools", *disallowed_tools(Path.home(), project),
            "--allowedTools", *allowed_tools(root, state, run_dir, project, slug)]


def agent_env():
    """The scrub variable makes Claude Code ignore --permission-mode (spike), so the child must not inherit it."""
    env = dict(os.environ, RETRO_HEADLESS="1")
    env.pop("CLAUDE_CODE_SUBPROCESS_ENV_SCRUB", None)
    env.pop("CLAUDECODE", None)  # started from a session's hook: the child is its own session, not a nested one
    return env


def too_broad(project):
    """True for the home folder, any folder above it (such as /Users or /), or a path that resolves to one."""
    return Path.home().resolve().is_relative_to(Path(project).resolve())  # a project inside home is fine


def run_agent(root, state, run_dir, project, slug, log):
    """Failure word, or None when the headless run succeeded."""
    if too_broad(project["project"]):
        return "bad-project"  # a read rule on the whole home folder or disk would defeat the scoping (#197)
    problem = scan_project(root, run_dir, project, slug)
    if problem:
        return problem
    (run_dir / WORK_DIR).mkdir(exist_ok=True)
    prompt = (f"Scheduled retro. Plugin root: {root}. State: {state}. Run folder: {run_dir}/. "
              f"Scan file (already made, read it): {run_dir}/{slug}.json. Use {slug} as the slug. "
              f"Write only in {run_dir}/{WORK_DIR}/. Projects (JSON): {json.dumps([project])}")
    try:
        with open(log, "a", encoding="utf-8") as out:
            run = subprocess.run(agent_command(root, state, run_dir, project["project"], slug, prompt),
                                 stdout=out, stderr=subprocess.STDOUT, cwd=str(run_dir), timeout=AGENT_TIMEOUT,
                                 env=agent_env())
    except subprocess.TimeoutExpired:
        return "agent-timeout"
    except OSError:
        return "agent-not-started"
    return f"agent-failed {run.returncode}" if run.returncode else None


def start_log(log):
    """Rotate a big log to retro.log.1, then add one separator line for this run."""
    log.parent.mkdir(parents=True, exist_ok=True)
    if log.exists() and log.stat().st_size > LOG_LIMIT:
        os.replace(log, log.with_name(log.name + ".1"))
    with open(log, "a", encoding="utf-8") as out:
        out.write(f"=== retro run {datetime.datetime.now().isoformat(timespec='seconds')} ===\n")


def check_due():
    """--check: run only the due check and log one line with the due count and the env this launcher saw, so a schedule
    test shows what launchd or cron really passes. No scan file, no agent, no publish. Always exits 0."""
    state, root = state_dir(), plugin_root()
    due, problem = scan_due(root) if root else ([], "plugin-not-found")
    seen = (f"PATH={'set' if os.environ.get('PATH') else 'unset'} HOME={os.environ.get('HOME')} "
            f"SOFTWARE_FACTORY_HOME={os.environ.get('SOFTWARE_FACTORY_HOME')}")
    count = f"unknown ({problem})" if problem else len(due)
    start = datetime.datetime.now().isoformat(timespec="seconds")
    state.mkdir(parents=True, exist_ok=True)
    with open(state / "retro.log", "a", encoding="utf-8") as out:
        out.write(f"retro check {start} due={count} {seen}\n")
    return 0


def main():
    args = sys.argv[1:]
    if args == ["--check"]:
        return check_due()
    under = args[1] if len(args) == 2 and args[0] == "--under" else None
    if args and not under:
        print("usage: retro-daily [--check | --under FOLDER]", file=sys.stderr)
        return 2
    state = state_dir()
    root = plugin_root()
    if not root:
        return fail(state, ["plugin-not-found"])
    log = state / "retro.log"
    start_log(log)  # every run leaves a line, so a run that found nothing is told apart from one that never ran
    due, problem = scan_due(root, log, under)
    if problem:
        return fail(state, [problem])
    if not due:
        # shortcut: retro-failed holds the last run's result, so a clean run for one project clears another's failure
        # (already shown at a session start); keep a line per project if that hides failures
        (state / "retro-failed").unlink(missing_ok=True)
        return 0
    today = datetime.date.today().isoformat()
    due = [d for d in due[:MAX_PROJECTS_PER_DAY] if claim(state, today, d["project"])]
    if not due:  # another run today has these projects; its result stays in retro-failed
        return 0
    day_dir = state / "retros" / today
    slugs = {p: free_slug(day_dir, p, s) for p, s in slug_map([d["project"] for d in due]).items()}
    folders = {d["project"]: project_folder(day_dir, d, slugs[d["project"]]) for d in due}
    results = [(d, run_agent(root, state, folders[d["project"]], d, slugs[d["project"]], log)) for d in due]
    failures = [f"{word} {slugs[d['project']]}" for d, word in results if word]
    if failures:
        return fail(state, failures)
    (state / "retro-failed").unlink(missing_ok=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""Turn the daily retro on or off.

  retro-schedule install     turn it on: the first session of the day in a folder starts the retro of the projects that
                             folder covers, in the background (hooks/retro_session.py)
  retro-schedule uninstall   turn it off

Both also remove the timed job older versions installed (a launchd agent on macOS, a crontab line elsewhere) and its
launcher copy in <state>/bin. That job ran without any folder access on macOS; the retro now runs with the access of the
session that starts it, so no Full Disk Access is needed. Stdlib only, Python 3.9+.
"""

import argparse
import os
from pathlib import Path
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "hooks"))
import overlay  # noqa: E402

OLD_LABELS = ("dev.software-factory.retro", "dev.software-factory.retro.check")
OLD_MARKERS = ("# software-factory-retro", "# software-factory-retro.check")


def state_dir():
    return overlay.state_dir()


def remove_old_jobs():
    if sys.platform == "darwin":
        for label in OLD_LABELS:
            subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{label}"], capture_output=True)
            (Path.home() / "Library" / "LaunchAgents" / f"{label}.plist").unlink(missing_ok=True)
    else:
        try:
            current = subprocess.run(["crontab", "-l"], capture_output=True, text=True)
        except OSError:  # no crontab on this machine, so no old line either
            current = None
        lines = current.stdout.splitlines() if current and current.returncode == 0 else []
        keep = [line for line in lines if not line.endswith(OLD_MARKERS)]
        if keep != lines:
            subprocess.run(["crontab", "-"], input="".join(line + "\n" for line in keep), text=True)
    (state_dir() / "bin" / "retro-daily").unlink(missing_ok=True)


def install():
    state = state_dir()
    state.mkdir(parents=True, exist_ok=True)
    remove_old_jobs()
    (state / overlay.AUTO_FILE).write_text("on\n")
    print("Daily retro on: the first session of the day in a factory project starts its retro in the background.")
    return 0


def uninstall():
    remove_old_jobs()
    (state_dir() / overlay.AUTO_FILE).unlink(missing_ok=True)
    print("Daily retro off. Run /software-factory:retro any time.")
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(description="Turn the daily retro on or off.")
    ap.add_argument("cmd", choices=("install", "uninstall"))
    a = ap.parse_args(argv)
    return install() if a.cmd == "install" else uninstall()


if __name__ == "__main__":
    sys.exit(main())
